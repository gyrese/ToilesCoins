rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Utilitaire : vérifie que l'utilisateur est admin dans Firestore
    function isAdmin() {
      return request.auth != null &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN";
    }

    // Utilisateurs : chaque user lit/modifie uniquement son propre profil
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId &&
                       request.resource.data.role == resource.data.role; // le rôle ne peut pas être changé par l'user
      allow delete: if false;

      // Sous-collection badges de l'utilisateur
      match /badges/{badgeId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if isAdmin();
      }
    }

    // Récompenses : lecture pour les users connectés, écriture admin seulement
    match /rewards/{rewardId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Événements : lecture publique, écriture admin seulement
    match /events/{eventId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Types d'événements : lecture pour les users connectés, écriture admin
    match /eventTypes/{typeId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Tournois : lecture pour les users connectés, écriture admin
    match /tournaments/{tournamentId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Coupons : propriétaire uniquement
    match /coupons/{couponId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null &&
                       resource.data.userId == request.auth.uid &&
                       request.resource.data.keys().hasOnly(['userId', 'rewardId', 'rewardName', 'rewardIcon', 'rewardDescription', 'code', 'status', 'expiresAt', 'createdAt']) &&
                       request.resource.data.status in ['active', 'expired', 'used'];
      allow delete: if false;
    }

    // Badges (catalogue global) : lecture publique, écriture admin seulement
    match /badges/{badgeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Transactions (audit log) : lecture admin, création par user connecté sur son propre uid
    match /transactions/{transactionId} {
      allow read: if isAdmin();
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
